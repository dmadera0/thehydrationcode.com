---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductCard from '@components/product/ProductCard.astro';
import Disclosure from '@components/product/Disclosure.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import { SITE } from '@data/site';
import { PRODUCTS_ENABLED } from '@lib/flags';

// Rest-parameter route (rather than a plain index.astro) so this page can be
// dropped from the build entirely when PRODUCTS_ENABLED is false — Astro has
// no other way to conditionally exclude a static page. An empty array here
// means zero routes are generated for this file. Named-parameter routes
// (../[slug].astro) take routing priority over rest-parameter routes, so
// this never shadows a bottle detail page.
export function getStaticPaths() {
  return PRODUCTS_ENABLED ? [{ params: { hub: undefined } }] : [];
}

const bottles = (await getCollection('bottles')).sort((a, b) => b.data.rating - a.data.rating);
const breadcrumbItems = [
  { name: 'Home', url: SITE.url },
  { name: 'Best Bottles', url: `${SITE.url}/best-bottles` },
];
---

<BaseLayout
  title="Best Glass Bottles"
  description="Glass water bottles we've actually evaluated — real pros and cons, no bottle with a clean sheet."
>
  <BreadcrumbSchema items={breadcrumbItems} />
  <div class="hub">
    <h1>Best Glass Bottles</h1>
    <p class="dek">
      Every bottle here gets a real verdict, including the parts that aren't flattering. If a review
      has no downsides, it's an advertisement.
    </p>

    <Disclosure />

    <h2 class="visually-hidden">All bottles</h2>
    <div class="grid">
      {bottles.map((bottle) => <ProductCard bottle={bottle} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .hub {
    max-width: var(--container-content);
    margin-inline: auto;
    padding: 3rem var(--spacing-gutter) 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  h1 {
    font-size: var(--text-section);
    line-height: var(--text-section--line-height);
    letter-spacing: var(--text-section--letter-spacing);
  }

  .dek {
    font-size: 1.125rem;
    max-width: var(--container-prose);
  }

  .grid {
    margin-block-start: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 2rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
</style>
