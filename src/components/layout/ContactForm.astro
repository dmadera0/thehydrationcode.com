---
/**
 * Same pattern as NewsletterForm.astro (same honeypot field, same
 * loading/success/error states, same endpoint), adapted for a message field
 * and posted with type: "contact". See NewsletterForm.astro's top comment
 * for why there's no meaningful no-JS fallback here either.
 */
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '';
---

<form class="contact-form" method="POST" action={endpoint || undefined} data-contact-form data-endpoint={endpoint}>
  <div class="honeypot">
    <label for="contact-company">Company</label>
    <input type="text" id="contact-company" name="company" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label for="contact-email">Email address</label>
    <input type="email" id="contact-email" name="email" placeholder="you@example.com" required />
  </div>

  <div class="field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" rows="6" placeholder="What's on your mind?" required></textarea>
  </div>

  <button type="submit" data-submit-btn>
    <span data-btn-label>Send message</span>
  </button>

  <p class="form-message" role="status" aria-live="polite" data-form-message></p>
</form>

<script>
  const form = document.querySelector('[data-contact-form]');

  if (form instanceof HTMLFormElement) {
    const endpoint = form.dataset.endpoint ?? '';
    const button = form.querySelector('[data-submit-btn]');
    const buttonLabel = form.querySelector('[data-btn-label]');
    const message = form.querySelector('[data-form-message]');
    const email = form.querySelector('#contact-email');
    const messageField = form.querySelector('#contact-message');
    const honeypot = form.querySelector('#contact-company');

    const setMessage = (text: string, state: string) => {
      if (!(message instanceof HTMLElement)) return;
      message.textContent = text;
      message.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (
        !(button instanceof HTMLButtonElement) ||
        !(email instanceof HTMLInputElement) ||
        !(messageField instanceof HTMLTextAreaElement)
      )
        return;
      if (honeypot instanceof HTMLInputElement && honeypot.value) return; // silently drop bots

      if (!email.checkValidity()) {
        setMessage('Enter a valid email address.', 'error');
        return;
      }
      if (!messageField.value.trim()) {
        setMessage('Add a message before sending.', 'error');
        return;
      }

      if (!endpoint) {
        setMessage("The contact form isn't live yet — email us instead once this is configured.", 'error');
        return;
      }

      button.disabled = true;
      if (buttonLabel) buttonLabel.textContent = 'Sending…';
      setMessage('', '');

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            email: email.value,
            type: 'contact',
            message: messageField.value,
            company: honeypot instanceof HTMLInputElement ? honeypot.value : '',
          }),
        });
        if (!response.ok) throw new Error('Request failed');
        setMessage("Message sent. We'll get back to you soon.", 'success');
        form.reset();
      } catch {
        setMessage('Something went wrong. Try again in a moment.', 'error');
      } finally {
        button.disabled = false;
        if (buttonLabel) buttonLabel.textContent = 'Send message';
      }
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 32rem;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .field input,
  .field textarea {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--color-ink);
  }

  .field textarea {
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-body);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  button[data-submit-btn] {
    align-self: flex-start;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-card);
    border: none;
    background-color: var(--color-brand);
    color: var(--color-surface);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  button[data-submit-btn]:hover {
    background-color: var(--color-brand-dark);
  }

  button[data-submit-btn]:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .form-message {
    min-height: 1.25rem;
    font-size: 0.875rem;
  }

  /* No red/warning token exists in the palette (see NewsletterForm.astro),
     so error vs. success leans on wording, not color, for the distinction —
     color-only signaling would fail contrast and a11y both. */
  .form-message[data-state='error'] {
    color: var(--color-ink);
    font-weight: 600;
  }

  .form-message[data-state='success'] {
    color: var(--color-brand);
    font-weight: 600;
  }
</style>
